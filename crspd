UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if isBindingKey and input.UserInputType == Enum.UserInputType.Keyboard then
		boundKey = input.KeyCode
		keybindBtn.Text = getKeyName(boundKey)
		keybindBtn.TextColor3 = Color3.fromRGB(200, 160, 255)
		isBindingKey = false
		return
	end

	if not gameProcessed and input.KeyCode == boundKey then
		isHoldingKey = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == boundKey then
		isHoldingKey = false
	end
end)

-- Slider interaction
local sliding = false

local function updateFromMouse(inputPos)
	local absPos = sliderBg.AbsolutePosition
	local absSize = sliderBg.AbsoluteSize
	local relative = math.clamp((inputPos.X - absPos.X) / absSize.X, 0, 1)
	currentSpeed = MIN_SPEED + relative * (MAX_SPEED - MIN_SPEED)
	updateSliderVisual(currentSpeed)
end

sliderBg.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		sliding = true
		updateFromMouse(input.Position)
	end
end)

sliderKnob.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		sliding = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		sliding = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateFromMouse(input.Position)
	end
end)

-- Speed boost logic
local function getVehicleSeat()
	local character = player.Character
	if not character then return nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return nil end
	local seat = humanoid.SeatPart
	if seat and seat:IsA("VehicleSeat") then
		return seat
	end
	return nil
end

local originalMaxSpeed = {}
local boostConnection = nil

local function applyBoost()
	local seat = getVehicleSeat()
	if not seat then return end

	if not originalMaxSpeed[seat] then
		originalMaxSpeed[seat] = seat.MaxSpeed
	end

	-- Apply boosted max speed while holding
	seat.MaxSpeed = currentSpeed

	-- Extra velocity boost for more noticeable effect
	local vehicle = seat.Parent
	if vehicle and vehicle:IsA("Model") then
		local primary = vehicle.PrimaryPart or seat
		if primary and primary:IsA("BasePart") then
			local look = primary.CFrame.LookVector
			local currentVel = primary.AssemblyLinearVelocity
			local forwardSpeed = currentVel:Dot(look)
			if forwardSpeed > 5 then -- only boost when already moving forward
				local boostForce = look * (currentSpeed * 0.35)
				primary.AssemblyLinearVelocity = currentVel + (boostForce - look * math.min(forwardSpeed * 0.15, currentSpeed * 0.1))
			end
		end
	end
end

local function restoreSpeed()
	for seat, maxSpd in pairs(originalMaxSpeed) do
		if seat and seat.Parent then
			seat.MaxSpeed = maxSpd
		end
	end
	originalMaxSpeed = {}
end

RunService.Heartbeat:Connect(function()
	if isHoldingKey then
		applyBoost()
	else
		if next(originalMaxSpeed) then
			restoreSpeed()
		end
	end
end)

-- Cleanup on character respawn
player.CharacterAdded:Connect(function()
	isHoldingKey = false
	restoreSpeed()
end)

