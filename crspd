-- Vehicle helpers
local function getVehicleSeat()
	local character = player.Character
	if not character then return nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return nil end
	local seat = humanoid.SeatPart
	if seat and seat:IsA("VehicleSeat") then
		return seat
	end
	return nil
end

local function getVehicleModel(seat)
	if not seat then return nil end
	local model = seat.Parent
	if model and model:IsA("Model") then
		return model
	end
	return nil
end

local function getPrimary(vehicle, seat)
	if vehicle and vehicle.PrimaryPart then
		return vehicle.PrimaryPart
	end
	return seat
end

local function getRoot()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

-- Speed boost (car)
local originalMaxSpeed = {}

local function applyBoost()
	local seat = getVehicleSeat()
	if not seat then return end
	if not originalMaxSpeed[seat] then
		originalMaxSpeed[seat] = seat.MaxSpeed
	end
	seat.MaxSpeed = currentSpeed
	local vehicle = getVehicleModel(seat)
	local primary = getPrimary(vehicle, seat)
	if primary and primary:IsA("BasePart") then
		local look = primary.CFrame.LookVector
		local currentVel = primary.AssemblyLinearVelocity
		local forwardSpeed = currentVel:Dot(look)
		if forwardSpeed > 5 then
			local boostForce = look * (currentSpeed * 0.35)
			primary.AssemblyLinearVelocity = currentVel + (boostForce - look * math.min(forwardSpeed * 0.15, currentSpeed * 0.1))
		end
	end
end

local function restoreSpeed()
	for seat, maxSpd in pairs(originalMaxSpeed) do
		if seat and seat.Parent then
			seat.MaxSpeed = maxSpd
		end
	end
	originalMaxSpeed = {}
end

-- Car fly + noclip
local originalCanCollide = {}
local isFlying = false

local function enableNoclip(vehicle)
	if not vehicle then return end
	for _, part in ipairs(vehicle:GetDescendants()) do
		if part:IsA("BasePart") then
			if originalCanCollide[part] == nil then
				originalCanCollide[part] = part.CanCollide
			end
			part.CanCollide = false
		end
	end
end

local function disableNoclip()
	for part, canCollide in pairs(originalCanCollide) do
		if part and part.Parent then
			part.CanCollide = canCollide
		end
	end
	originalCanCollide = {}
end

local function applyFly(dt)
	local seat = getVehicleSeat()
	if not seat then
		if isFlying then
			disableNoclip()
			isFlying = false
		end
		return
	end
	local vehicle = getVehicleModel(seat)
	if not vehicle then return end
	local primary = getPrimary(vehicle, seat)
	if not primary or not primary:IsA("BasePart") then return end
	if not isFlying then
		enableNoclip(vehicle)
		isFlying = true
	end
	local camera = workspace.CurrentCamera
	local forward = camera.CFrame.LookVector
	local right = camera.CFrame.RightVector
	local move = Vector3.zero
	if flyForward then move = move + forward end
	if flyBack then move = move - forward end
	if flyRight then move = move + right end
	if flyLeft then move = move - right end
	if move.Magnitude > 0 then
		move = move.Unit * currentFlySpeed * dt
		primary.CFrame = primary.CFrame + move
	end
	primary.AssemblyLinearVelocity = Vector3.zero
	primary.AssemblyAngularVelocity = Vector3.zero
end

local function stopFly()
	if isFlying then
		disableNoclip()
		isFlying = false
		local seat = getVehicleSeat()
		if seat then
			local vehicle = getVehicleModel(seat)
			local primary = getPrimary(vehicle, seat)
			if primary and primary:IsA("BasePart") then
				primary.AssemblyLinearVelocity = Vector3.zero
				primary.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end
end

-- Player speed
local originalWalkSpeed = nil

local function applyPlSpeed()
	local humanoid = getHumanoid()
	if not humanoid then return end
	if originalWalkSpeed == nil then
		originalWalkSpeed = humanoid.WalkSpeed
	end
	humanoid.WalkSpeed = currentPlSpeed
end

local function restorePlSpeed()
	local humanoid = getHumanoid()
	if humanoid and originalWalkSpeed ~= nil then
		humanoid.WalkSpeed = originalWalkSpeed
	end
	originalWalkSpeed = nil
end

-- Player fly + noclip
local plOriginalCanCollide = {}
local isPlFlying = false

local function enablePlNoclip()
	local char = player.Character
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			if plOriginalCanCollide[part] == nil then
				plOriginalCanCollide[part] = part.CanCollide
			end
			part.CanCollide = false
		end
	end
end

local function disablePlNoclip()
	for part, canCollide in pairs(plOriginalCanCollide) do
		if part and part.Parent then
			part.CanCollide = canCollide
		end
	end
	plOriginalCanCollide = {}
end

local function applyPlFly(dt)
	local root = getRoot()
	if not root then
		if isPlFlying then
			disablePlNoclip()
			isPlFlying = false
		end
		return
	end

	isPlFlying = true
	-- re-apply every frame so engine does not restore collisions
	enablePlNoclip()

	local camera = workspace.CurrentCamera
	local forward = camera.CFrame.LookVector
	local right = camera.CFrame.RightVector
	local move = Vector3.zero
	if flyForward then move = move + forward end
	if flyBack then move = move - forward end
	if flyRight then move = move + right end
	if flyLeft then move = move - right end

	if move.Magnitude > 0 then
		move = move.Unit * currentPlFlySpeed * dt
	end

	root.CFrame = root.CFrame + move
	root.AssemblyLinearVelocity = Vector3.zero
end

local function stopPlFly()
	if isPlFlying then
		disablePlNoclip()
		isPlFlying = false
		local root = getRoot()
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

-- Main loop
RunService.RenderStepped:Connect(function(dt)
	if isHoldingKey then
		applyBoost()
	else
		if next(originalMaxSpeed) then
			restoreSpeed()
		end
	end

	if isHoldingFlyKey then
		applyFly(dt)
	else
		stopFly()
	end

	if spPlEnabled then
		applyPlSpeed()
	else
		if originalWalkSpeed ~= nil then
			restorePlSpeed()
		end
	end

	if isHoldingPlFlyKey then
		applyPlFly(dt)
	else
		stopPlFly()
	end
end)

