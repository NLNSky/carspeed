		flyBoundKey = input.KeyCode
		flyKeybindBtn.Text = getKeyName(flyBoundKey)
		flyKeybindBtn.TextColor3 = Color3.fromRGB(200, 160, 255)
		isBindingFlyKey = false
		return
	end

	if not gameProcessed then
		if input.KeyCode == boundKey then
			isHoldingKey = true
		end
		if input.KeyCode == flyBoundKey then
			isHoldingFlyKey = true
		end
		if input.KeyCode == Enum.KeyCode.W then flyForward = true end
		if input.KeyCode == Enum.KeyCode.S then flyBack = true end
		if input.KeyCode == Enum.KeyCode.A then flyLeft = true end
		if input.KeyCode == Enum.KeyCode.D then flyRight = true end
		if input.KeyCode == Enum.KeyCode.Space then flyUp = true end
		if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.C then flyDown = true end
	end
end)

