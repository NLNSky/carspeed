	if input.KeyCode == flyBoundKey then
		isHoldingFlyKey = false
	end
	if input.KeyCode == Enum.KeyCode.W then flyForward = false end
	if input.KeyCode == Enum.KeyCode.S then flyBack = false end
	if input.KeyCode == Enum.KeyCode.A then flyLeft = false end
	if input.KeyCode == Enum.KeyCode.D then flyRight = false end
	if input.KeyCode == Enum.KeyCode.Space then flyUp = false end
	if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.C then flyDown = false end
end)

-- Sliders
local sliding = false
local flySliding = false

local function updateFromMouse(inputPos)
	local absPos = sliderBg.AbsolutePosition
	local absSize = sliderBg.AbsoluteSize
	local relative = math.clamp((inputPos.X - absPos.X) / absSize.X, 0, 1)
	currentSpeed = MIN_SPEED + relative * (MAX_SPEED - MIN_SPEED)
	updateSliderVisual(currentSpeed)
end

local function updateFlyFromMouse(inputPos)
	local absPos = flySliderBg.AbsolutePosition
	local absSize = flySliderBg.AbsoluteSize
	local relative = math.clamp((inputPos.X - absPos.X) / absSize.X, 0, 1)
	currentFlySpeed = MIN_SPEED + relative * (MAX_SPEED - MIN_SPEED)
	updateFlySliderVisual(currentFlySpeed)
end

