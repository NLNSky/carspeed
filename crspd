-- Helpers
local function getKeyName(keyCode)
	return tostring(keyCode):gsub("Enum.KeyCode.", "")
end

local function updateSliderVisual(value)
	local alpha = math.clamp((value - MIN_SPEED) / (MAX_SPEED - MIN_SPEED), 0, 1)
	sliderFill.Size = UDim2.new(alpha, 0, 1, 0)
	sliderKnob.Position = UDim2.new(alpha, -7, 0.5, -7)
	sliderLabel.Text = "Speed: " .. tostring(math.floor(value + 0.5))
end

local function updateFlySliderVisual(value)
	local alpha = math.clamp((value - MIN_SPEED) / (MAX_SPEED - MIN_SPEED), 0, 1)
	flySliderFill.Size = UDim2.new(alpha, 0, 1, 0)
	flySliderKnob.Position = UDim2.new(alpha, -7, 0.5, -7)
	flySliderLabel.Text = "Fly Speed: " .. tostring(math.floor(value + 0.5))
end

local function updatePlSpeedVisual(value)
	local alpha = math.clamp((value - MIN_SPEED) / (MAX_SPEED - MIN_SPEED), 0, 1)
	plSpeedFill.Size = UDim2.new(alpha, 0, 1, 0)
	plSpeedKnob.Position = UDim2.new(alpha, -7, 0.5, -7)
	plSpeedLabel.Text = "Pl Speed: " .. tostring(math.floor(value + 0.5))
end

local function updatePlFlySliderVisual(value)
	local alpha = math.clamp((value - MIN_SPEED) / (MAX_SPEED - MIN_SPEED), 0, 1)
	plFlySliderFill.Size = UDim2.new(alpha, 0, 1, 0)
	plFlySliderKnob.Position = UDim2.new(alpha, -7, 0.5, -7)
	plFlySliderLabel.Text = "Pl Fly Speed: " .. tostring(math.floor(value + 0.5))
end

local function setCollapsed(collapsed)
	isCollapsed = collapsed
	if collapsed then
		content.Visible = false
		mainFrame.Size = COLLAPSED_SIZE
		collapseBtn.Text = "+"
	else
		content.Visible = true
		mainFrame.Size = PANEL_SIZE
		collapseBtn.Text = "−"
	end
end

local function updateSpPlBtn()
	if spPlEnabled then
		spPlBtn.Text = "Sp Pl ON"
		spPlBtn.BackgroundColor3 = Color3.fromRGB(140, 60, 255)
		spPlBtn.TextColor3 = Color3.fromRGB(15, 15, 15)
	else
		spPlBtn.Text = "Sp Pl"
		spPlBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
		spPlBtn.TextColor3 = Color3.fromRGB(200, 160, 255)
	end
end

-- Dragging
topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
	end
end)

topBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

collapseBtn.MouseButton1Click:Connect(function()
	setCollapsed(not isCollapsed)
end)

spPlBtn.MouseButton1Click:Connect(function()
	spPlEnabled = not spPlEnabled
	updateSpPlBtn()
end)

-- Keybinds
keybindBtn.MouseButton1Click:Connect(function()
	if isBindingKey or isBindingFlyKey or isBindingPlFlyKey then return end
	isBindingKey = true
	keybindBtn.Text = "..."
	keybindBtn.TextColor3 = Color3.fromRGB(255, 200, 100)
end)

flyKeybindBtn.MouseButton1Click:Connect(function()
	if isBindingKey or isBindingFlyKey or isBindingPlFlyKey then return end
	isBindingFlyKey = true
	flyKeybindBtn.Text = "..."
	flyKeybindBtn.TextColor3 = Color3.fromRGB(255, 200, 100)
end)

plFlyKeybindBtn.MouseButton1Click:Connect(function()
	if isBindingKey or isBindingFlyKey or isBindingPlFlyKey then return end
	isBindingPlFlyKey = true
	plFlyKeybindBtn.Text = "..."
	plFlyKeybindBtn.TextColor3 = Color3.fromRGB(255, 200, 100)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if isBindingKey and input.UserInputType == Enum.UserInputType.Keyboard then
		boundKey = input.KeyCode
		keybindBtn.Text = getKeyName(boundKey)
		keybindBtn.TextColor3 = Color3.fromRGB(200, 160, 255)
		isBindingKey = false
		return
	end
	if isBindingFlyKey and input.UserInputType == Enum.UserInputType.Keyboard then
		flyBoundKey = input.KeyCode
		flyKeybindBtn.Text = getKeyName(flyBoundKey)
		flyKeybindBtn.TextColor3 = Color3.fromRGB(200, 160, 255)
		isBindingFlyKey = false
		return
	end
	if isBindingPlFlyKey and input.UserInputType == Enum.UserInputType.Keyboard then
		plFlyBoundKey = input.KeyCode
		plFlyKeybindBtn.Text = getKeyName(plFlyBoundKey)
		plFlyKeybindBtn.TextColor3 = Color3.fromRGB(200, 160, 255)
		isBindingPlFlyKey = false
		return
	end

	if not gameProcessed then
		if input.KeyCode == boundKey then isHoldingKey = true end
		if input.KeyCode == flyBoundKey then isHoldingFlyKey = true end
		if input.KeyCode == plFlyBoundKey then isHoldingPlFlyKey = true end
